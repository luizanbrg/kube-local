# Copier ce fichier en .env puis remplir les valeurs vides
# Générer APP_KEY avec : php artisan key:generate --show

# --- Application ---
APP_ENV=dev
APP_DEBUG=true
APP_KEY=

# --- Connexion de l'app à la base ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nom_de_la_base
DB_USERNAME=nom_utilisateur
DB_PASSWORD=

# --- Conteneur MySQL (service db) ---
MYSQL_ROOT_PASSWORD=
